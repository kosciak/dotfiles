{
    "lm_sensors": {
        "tags": ["system"],
        "copy": [
            "/etc/sensors.d/ASUS_Prime_B550_Plus"
        ]
    },
    "etc_profile": {
        "tags": ["system"],
        "copy": [
            "/etc/profile.d/attrs_colors.sh",
            "/etc/profile.d/color_prompt.sh"
        ]
    },

    "bash": {
        "tags": ["user"],
        "reference": "https://wiki.archlinux.org/title/Bash",
        "symlink": [
            ".profile",
            ".bash_profile",
            ".bash_logout",
            ".bashrc",
            ".bashrc.d"
        ]
    },
    "readline": {
        "tags": ["user"],
        "reference": "https://wiki.archlinux.org/title/Readline",
        "symlink": [
            ".inputrc"
        ]
    },
    "dircolors": {
        "tags": ["user"],
        "symlink": [
            ".dircolors"
        ]
    },
    "tealdeer": {
        "tags": ["user"],
        "reference": "https://github.com/sharkdp/bat",
        "symlink": [
            ".config/tealdeer"
        ]
    },
    "most": {
        "tags": ["user"],
        "reference": "https://github.com/FauxFaux/most-pager",
        "symlink": [
            ".mostrc"
        ]
    },
    "bat": {
        "tags": ["user"],
        "reference": "https://github.com/sharkdp/bat",
        "symlink": [
            ".config/bat"
        ]
    },
    "screen": {
        "tags": ["user"],
        "reference": "https://wiki.archlinux.org/title/GNU_Screen",
        "symlink": [
            ".screenrc"
        ]
    },
    "tmux": {
        "tags": ["user"],
        "reference": "https://wiki.archlinux.org/title/tmux",
        "symlink": [
            ".config/tmux"
        ]
    },
    "vim": {
        "tags": ["user"],
        "symlink": [
            ".vim",
            ".vimrc",
            ".gvimrc"
        ]
    },
    "git": {
        "tags": ["user"],
        "symlink": [
            ".gitconfig",
            ".gitignore_global"
        ]
    },
    "alacritty": {
        "tags": ["user"],
        "reference": "https://alacritty.org/config-alacritty.html",
        "note": "No default config provided, migration to toml removes all comments",
        "symlink": [
            ".config/alacritty"
        ]
    },
    "kitty": {
        "tags": ["user"],
        "reference": "https://sw.kovidgoyal.net/kitty/conf/",
        "symlink": [
            ".config/kitty"
        ]
    },
    "krita": {
        "tags": ["user"],
        "reference": "https://docs.krita.org/en/KritaFAQ.html#where-are-the-configuration-files-stored",
        "symlink": [
            ".config/kritarc"
        ]
    },
    "xppen": {
        "tags": ["user"],
        "reference": "",
        "note": "Format of .pcfg files with configs might change on XPPen driver version basis!",
        "symlink": [
            ".config/xppen"
        ]
    },

    "X": {
        "tags": ["obsolete"],
        "reference": "https://wiki.archlinux.org/title/X_resources",
        "comments": "Contains xterm settings. TODO: Consider converting to .Xresources",
        "symlink": [
            ".Xdefaults"
        ]
    },
    "vimperator": {
        "tags": ["obsolete"],
        "reference": "http://vimperator.org/",
        "symlink": [
            ".vimperatorrc",
            ".vimperator"
        ]
    },
    "roxterm": {
        "tags": ["obsolete"],
        "symlink": [
            ".config/roxterm.sourceforge.net"
        ]
    }

}

